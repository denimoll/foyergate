# ──────────────────────────────────────────────────────────────────────────────
# FoyerGate — example configuration
#
# Copy this file to `.env` and adjust values for your environment.
# Do NOT commit `.env` (it's in .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────
FOYERGATE_ENV=development              # development | staging | production
FOYERGATE_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
FOYERGATE_API_HOST=0.0.0.0
FOYERGATE_API_PORT=9876

# ── Database (PostgreSQL) ──────────────────────────────────────────
FOYERGATE_DB_DSN=postgresql+asyncpg://foyergate:foyergate@postgres:5432/foyergate

# ── Cache & queue (Redis) ──────────────────────────────────────────
FOYERGATE_REDIS_URL=redis://redis:6379/0

# ── Object storage (S3-compatible, e.g. MinIO) ─────────────────────
FOYERGATE_S3_ENDPOINT=http://minio:9000
FOYERGATE_S3_REGION=us-east-1
FOYERGATE_S3_ACCESS_KEY=foyergate
FOYERGATE_S3_SECRET_KEY=changeme-in-production
FOYERGATE_S3_BUCKET_QUARANTINE=foyergate-quarantine
FOYERGATE_S3_BUCKET_REPORTS=foyergate-reports

# ── Policy engine (OPA) ────────────────────────────────────────────
FOYERGATE_OPA_URL=http://opa:8181
FOYERGATE_OPA_POLICY_PACKAGE=foyergate.default

# ── Internal artifact repository (Sonatype Nexus) ──────────────────
FOYERGATE_NEXUS_URL=http://nexus:8081
FOYERGATE_NEXUS_USERNAME=admin
FOYERGATE_NEXUS_PASSWORD=changeme-in-production
FOYERGATE_NEXUS_NPM_REPOSITORY=npm-internal

# ── Upstream registries (where we fetch from) ──────────────────────
FOYERGATE_NPM_REGISTRY_URL=https://registry.npmjs.org

# ── Verdict cache TTL (seconds) ────────────────────────────────────
# How long an ALLOW verdict is considered valid before requiring re-evaluation.
FOYERGATE_VERDICT_TTL_SECONDS=604800   # 7 days

# ── Rescan schedule (cron format) ──────────────────────────────────
FOYERGATE_RESCAN_CRON="0 3 * * *"      # every day at 03:00 UTC
